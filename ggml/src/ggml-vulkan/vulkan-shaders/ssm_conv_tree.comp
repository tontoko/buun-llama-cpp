#version 450

#extension GL_EXT_control_flow_attributes : require

#include "types.glsl"

layout(constant_id = 0) const uint BLOCK_SIZE = 128;
layout(constant_id = 1) const uint D_CONV = 4;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer Src0 { float src0[]; };
layout(binding = 1) readonly buffer Src1 { float src1[]; };
layout(binding = 2) readonly buffer ParentIds { int parent_ids[]; };
layout(binding = 3) buffer Dst { float dst[]; };

layout(push_constant) uniform PushConstants {
    uint nb01; uint nb02;
    uint nb11;
    uint dst_nb0; uint dst_nb1; uint dst_nb2;
    uint nr; uint n_t; uint n_s;
};

shared int slot_window[9];

float silu(float x) {
    return x / (1.0 + exp(-x));
}

void main() {
    const uint i1 = gl_WorkGroupID.y * BLOCK_SIZE + gl_LocalInvocationID.x;
    const uint i3 = gl_WorkGroupID.x;
    const bool valid = i1 < nr;

    const uint src0_base = i3 * (nb02 / 4) + i1 * (nb01 / 4);
    const uint src1_base = i1 * (nb11 / 4);

    float w[9];
    if (valid) {
        [[unroll]] for (uint j = 0; j < D_CONV; j++) {
            w[j] = src1[src1_base + j];
        }
    }

    for (uint i = 0; i < n_t; i++) {
        if (gl_LocalInvocationID.x == 0) {
            slot_window[D_CONV - 1] = int(i);
            for (int k = int(D_CONV) - 2; k >= 0; k--) {
                int prev = slot_window[k + 1];
                if (prev >= 0) {
                    slot_window[k] = parent_ids[prev];
                } else {
                    slot_window[k] = prev - 1;
                }
            }
        }
        barrier();

        if (valid) {
            float sumf = 0.0;
            [[unroll]] for (uint j = 0; j < D_CONV; j++) {
                int slot = int(D_CONV - 1) + slot_window[j];
                sumf += src0[src0_base + uint(slot)] * w[j];
            }

            const uint dst_idx = i3 * (dst_nb2 / 4) + i * (dst_nb1 / 4) + i1;
            dst[dst_idx] = silu(sumf);
        }
    }
}
